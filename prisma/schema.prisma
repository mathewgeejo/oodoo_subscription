generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN
  STAFF
  CUSTOMER
}
enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}
enum Cadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}
enum CheckoutStatus {
  RESERVING
  OPEN
  PAID
  EXPIRED
  FAILED
  EXCEPTION
}
enum ProductType {
  SERVICE
  DIGITAL
  PHYSICAL
}
enum DiscountKind {
  FIXED
  PERCENTAGE
}
enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscriptions Subscription[]
  @@index([role, name])
  @@map("users")
}
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id                     String @id
  accountId              String
  providerId             String
  userId                 String
  password               String?
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
}
model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}
model Subscription {
  id                String @id @default(cuid())
  number            String @unique
  customerId        String
  customer          User @relation(fields: [customerId], references: [id])
  planId            String?
  plan              Plan? @relation(fields: [planId], references: [id])
  templateId        String?
  template          QuotationTemplate? @relation(fields: [templateId], references: [id])
  quotationValidityDays Int @default(14)
  quotationExpiresAt DateTime?
  status            SubscriptionStatus @default(DRAFT)
  planName          String
  cadence           Cadence
  basePrice         Decimal @db.Decimal(18, 2)
  baseTaxPercent    Decimal @default(0) @db.Decimal(5, 2)
  billingTimezone   String @default("Asia/Kolkata")
  currency          String @default("INR")
  minimumQuantity   Int @default(1)
  canPause          Boolean @default(false)
  canRenew          Boolean @default(true)
  canCloseEarly     Boolean @default(false)
  autoClose         Boolean @default(true)
  startAt           DateTime
  expiresAt         DateTime
  paymentTermDays   Int @default(14)
  nextPeriodIndex   Int @default(0)
  nextBillingAt     DateTime?
  pendingAction     String?
  pendingActionAt   DateTime?
  version           Int @default(0)
  billingFailureCount Int @default(0)
  billingRetryAt    DateTime?
  billingLastError  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lines             SubscriptionLine[]
  invoices          Invoice[]
  @@index([status, nextBillingAt])
  @@index([status, expiresAt])
  @@index([customerId, createdAt])
}
model SubscriptionLine {
  id             String @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(18, 2)
  taxPercent     Decimal @db.Decimal(5, 2)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([subscriptionId])
}
model Invoice {
  id             String @id @default(cuid())
  number         String @unique
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  periodIndex    Int
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  status         InvoiceStatus @default(DRAFT)
  currency       String
  customerName   String
  customerEmail  String
  subtotal       Decimal @db.Decimal(18, 2)
  discount       Decimal @db.Decimal(18, 2)
  tax            Decimal @db.Decimal(18, 2)
  total          Decimal @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lines          InvoiceLine[]
  payments       Payment[]
  checkouts      CheckoutAttempt[]
  discountUse    DiscountUse?
  notifications  NotificationJob[]
  @@unique([subscriptionId, periodIndex])
  @@index([status, dueAt])
  @@index([createdAt])
}
model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(18, 2)
  taxPercent  Decimal @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(18, 2)
  discount    Decimal @db.Decimal(18, 2)
  tax         Decimal @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([invoiceId])
}
model Payment {
  id         String @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  amount     Decimal @db.Decimal(18, 2)
  method     String
  paidAt     DateTime
  note       String?
  reference  String @unique
  externalReference String?
  recordedBy String
  createdAt  DateTime @default(now())
  @@index([invoiceId])
}
model AuditEvent {
  id         String @id @default(cuid())
  actorId    String
  action     String
  resourceId String
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([resourceId, createdAt])
}
model WorkerHeartbeat {
  id        String @id
  lastSeen  DateTime
}
model CheckoutAttempt {
  id                String @id @default(cuid())
  invoiceId         String
  invoice           Invoice @relation(fields: [invoiceId], references: [id])
  createdBy         String
  idempotencyKey    String @unique
  amount            Decimal @db.Decimal(18, 2)
  currency          String
  status            CheckoutStatus @default(RESERVING)
  providerSessionId String? @unique
  providerPaymentId String? @unique
  receivedAmount    Decimal? @db.Decimal(18, 2)
  receivedCurrency  String?
  checkoutUrl       String?
  failureCode       String?
  expiresAt         DateTime
  nextReconcileAt   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([status, nextReconcileAt])
  receipts          ProviderReceipt[]
}
model ProviderEvent {
  id          String @id
  type        String
  attemptId   String
  outcome     String
  processedAt DateTime @default(now())
}
model ProviderReceipt {
  id                String @id
  attemptId         String
  attempt           CheckoutAttempt @relation(fields: [attemptId], references: [id])
  providerSessionId String
  amount            Decimal? @db.Decimal(18, 2)
  currency          String?
  outcome           String
  createdAt         DateTime @default(now())
  @@index([outcome, createdAt])
}

model Product {
  id           String @id @default(cuid())
  name         String
  type         ProductType
  salesPrice   Decimal @db.Decimal(18, 2)
  costPrice    Decimal @db.Decimal(18, 2)
  notes        String @default("")
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  variants     ProductVariant[]
  taxRuleId    String?
  taxRule      TaxRule? @relation(fields: [taxRuleId], references: [id])
  templateLines TemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines InvoiceLine[]
  discountTargets DiscountProduct[]
  @@index([active, name])
}
model ProductVariant {
  id             String @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  priceAdjustment Decimal @db.Decimal(18, 2)
  active          Boolean @default(true)
  templateLines TemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines InvoiceLine[]
  @@unique([productId, name])
}
model Plan {
  id              String @id @default(cuid())
  name            String
  basePrice       Decimal @db.Decimal(18, 2)
  baseTaxPercent  Decimal @default(0) @db.Decimal(5, 2)
  cadence         Cadence
  minimumQuantity Int @default(1)
  availableFrom   DateTime?
  availableUntil  DateTime?
  canPause        Boolean @default(false)
  canRenew        Boolean @default(true)
  canCloseEarly   Boolean @default(false)
  autoClose       Boolean @default(true)
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  templates       QuotationTemplate[]
  subscriptions   Subscription[]
  taxRuleId       String?
  taxRule         TaxRule? @relation(fields: [taxRuleId], references: [id])
  @@index([active, name])
}
model QuotationTemplate {
  id           String @id @default(cuid())
  name         String
  planId       String
  plan         Plan @relation(fields: [planId], references: [id])
  validityDays Int @default(14)
  lines        TemplateLine[]
  subscriptions Subscription[]
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model TaxRule {
  id         String @id @default(cuid())
  name       String
  percent    Decimal @db.Decimal(5, 2)
  active     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  products   Product[]
  plans      Plan[]
}
model DiscountRule {
  id              String @id @default(cuid())
  name            String
  kind            DiscountKind
  value           Decimal @db.Decimal(18, 2)
  minimumPurchase Decimal @default(0) @db.Decimal(18, 2)
  minimumQuantity Int @default(1)
  startsAt        DateTime
  endsAt          DateTime
  usageLimit      Int
  usageCount      Int @default(0)
  targets         DiscountProduct[]
  uses            DiscountUse[]
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([active, startsAt, endsAt])
}
model TemplateLine {
  id         String @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  @@index([templateId])
}
model DiscountProduct {
  discountId String
  discount   DiscountRule @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  @@id([discountId, productId])
}
model DiscountUse {
  id         String @id @default(cuid())
  discountId String
  discount   DiscountRule @relation(fields: [discountId], references: [id])
  invoiceId  String @unique
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  amount     Decimal @db.Decimal(18, 2)
  restoredAt DateTime?
  createdAt  DateTime @default(now())
  @@index([discountId])
}
model NotificationJob {
  id             String @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  kind           String
  idempotencyKey String @unique
  status         DeliveryStatus @default(PENDING)
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  leaseUntil     DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  @@index([status, nextAttemptAt])
}
