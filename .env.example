DATABASE_URL=postgresql://subscription:subscription@localhost:5432/subscription?schema=public
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated additional exact origins. Same-port loopback aliases
# are already allowed in development. Production never adds aliases implicitly.
BETTER_AUTH_TRUSTED_ORIGINS=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Brightloop <billing@example.com>
SMTP_USER=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_CURRENCY=INR
BUSINESS_TIMEZONE=Asia/Kolkata
# Optional: populate an existing customer account's portal in the demo database.
DEMO_CUSTOMER_EMAIL=
DEMO_SEED_PASSWORD=
